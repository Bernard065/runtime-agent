# ─── Application ───
APP_NAME=runtime-agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_runtime
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600

# ─── LLM ───
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ─── Memory ───
MEMORY_WORKING_WINDOW_SIZE=20
MEMORY_SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_SEMANTIC_TOP_K=5
MEMORY_EPISODIC_MAX_RECALL=10

# ─── Security ───
API_KEY_HEADER=X-API-Key
API_KEYS=dev-key-1,dev-key-2

# ─── Observability ───
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
